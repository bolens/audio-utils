# GitHub Actions / editor junk
.DS_Store
*.swp
*~

# Nested tool run artifacts (cwd overrides / legacy)
**/wav-to-flac-failures.log
**/wav-to-flac-success.csv
**/wav-to-flac-success.jsonl
**/failures.log
**/success.csv
**/success.jsonl
**/.wav2flac.*/
**/.audio-utils.*/

# Local auth experiment fixtures
.tmp-auth-test/
.tmp-util-test.*/
.tmp-codec-*/

# Test fixture cache (rebuilt on demand by tests/fixtures.sh)
tests/.cache/

# Optional MCP npm deps + machine-local Cursor MCP config
mcp/npm/node_modules/
.cursor/mcp.json
.cursor/mcp.json.bak

# Isolated optional codec installations restored by CI
.ci-cache/

# Local tooling and runtime artifacts
__pycache__/
*.py[cod]
.ruff_cache/

# Local devenv state and overrides
.devenv/
.direnv/
.devenv.*/
.devenv.flake.nix
devenv.local.nix
devenv.local.yaml

# Shared VS Code configuration; keep personal editor state ignored.
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/*.code-snippets
!/.vscode/README.md

# Copy .mcp.json.example locally and set explicit checkout/resource paths.
/.mcp.json
